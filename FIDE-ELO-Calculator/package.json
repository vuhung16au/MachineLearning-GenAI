{
  "name": "fide-elo-calculator",
  "version": "1.0.0",
  "scripts": {
    "start": "http-server -p 8080",
    "test": "cypress open",
    "test:headless": "cypress run",
    "cy:run": "start-server-and-test start http://localhost:8080 test:headless",
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/styles.css",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./css/styles.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cypress": "^12.0.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.3",
    "start-server-and-test": "^2.0.11",
    "tailwindcss": "^4.1.4"
  }
}
